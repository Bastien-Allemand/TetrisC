{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build Tetris",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\tetris.exe",
                "${workspaceFolder}\\main.c",
                "${workspaceFolder}\\c\\controls.c",
                "${workspaceFolder}\\c\\display.c",
                "${workspaceFolder}\\c\\grid.c",
                "${workspaceFolder}\\c\\objectManipulation.c",
                "${workspaceFolder}\\c\\shapeCreation.c"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}